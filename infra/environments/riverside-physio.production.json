{
  "environment": "production",
  "tenant": "riverside-physio",
  "description": "Live clinic environment for Riverside Physiotherapy & Rehab. Real callers, real calendar, real patient records.",
  "readonlyRootFilesystem": false,
  "values": {
    "SERVICE": "riverside-physio",
    "ENVIRONMENT": "production",
    "NODE_ENV": "production",
    "AWS_ACCOUNT_ID": "REPLACE_WITH_AWS_ACCOUNT_ID",
    "AWS_REGION": "us-east-1",
    "TASK_CPU": "512",
    "TASK_MEMORY": "1024",
    "BUSINESS_NAME": "Riverside Physiotherapy & Rehab",
    "BUSINESS_PHONE": "+1 951-555-0100",
    "BUSINESS_ADDRESS": "12 River Road, Riverside, CA 92501",
    "BUSINESS_WEBSITE": "https://www.riverside-physio.example",
    "TIMEZONE": "America/Los_Angeles",
    "DEFAULT_APPOINTMENT_DURATION": "45",
    "GOOGLE_CALENDAR_ID": "REPLACE_WITH_PRODUCTION_CALENDAR_ID",
    "GOOGLE_SPREADSHEET_ID": "REPLACE_WITH_PRODUCTION_SPREADSHEET_ID",
    "GOOGLE_IMPERSONATE_EMAIL": "",
    "EMAIL_FROM": "onboarding@resend.dev",
    "EMAIL_REPLY_TO": "onboarding@resend.dev",
    "TOOL_AUTH_HEADER": "x-tool-auth",
    "TOOL_AUTH_VERSION": "v1",
    "APPOINTMENT_TOKEN_TTL_MS": "600000",
    "TELEPHONY_CALLER_PHONE_HEADER": "x-caller-phone",
    "TELEPHONY_CALL_ID_HEADER": "x-call-id",
    "ALLOWED_ORIGINS": "",
    "REQUEST_BODY_LIMIT": "32kb",
    "RATE_LIMIT_WINDOW_MS": "60000",
    "RATE_LIMIT_MAX": "60",
    "IDEMPOTENCY_TTL_MS": "900000",
    "TRUST_PROXY_HOPS": "1"
  }
}
