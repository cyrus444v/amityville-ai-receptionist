# ============================================================
# AI Receptionist Backend – Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# Server
PORT=3001

# -------------------------------------------------------
# Google Calendar (Service Account)
# 1. Create a Google Cloud project
# 2. Enable the Google Calendar API
# 3. Create a Service Account and store its JSON key in your secret manager
# 4. Share your Google Calendar with the service account email
# 5. Fill in the values below
# -------------------------------------------------------
GOOGLE_CREDENTIALS_BASE64=operator-supplied-base64-service-account-json
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# -------------------------------------------------------
# Google Sheets (storage — HIPAA-covered under Google Workspace BAA)
# 1. Create a Google Sheet and share it with your service account email (Editor)
# 2. Copy the spreadsheet ID from the URL:
#    https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
# -------------------------------------------------------
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id

# -------------------------------------------------------
# Business Settings
# -------------------------------------------------------
BUSINESS_NAME=Amityville Acupuncture

# Self-ping to prevent Render free-tier cold starts (set to your backend URL)
# SELF_PING_URL=https://amityville-ai-receptionist.onrender.com

# -------------------------------------------------------
# Email (Resend) — https://resend.com
# 1. Sign up at resend.com (free — 100 emails/day)
# 2. Get your API key from the dashboard
# 3. For production: verify your domain and set EMAIL_FROM
# 4. For testing: use EMAIL_FROM=onboarding@resend.dev (sends to your verified address only)
# -------------------------------------------------------
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=appointments@yourdomain.com
EMAIL_REPLY_TO=info@yourdomain.com
BUSINESS_PHONE=+1 (631) 555-0000
BUSINESS_ADDRESS=Amityville, NY
BUSINESS_WEBSITE=https://www.amityvillewellness.com
TIMEZONE=America/New_York
DEFAULT_APPOINTMENT_DURATION=60

# Security and shared coordination (all secret values are operator-generated)
TOOL_AUTH_SECRET=operator-supplied-high-entropy-secret
APPOINTMENT_TOKEN_SECRET=operator-supplied-distinct-high-entropy-secret
RETELL_WEBHOOK_SECRET=operator-supplied-retell-webhook-key
COORDINATION_TABLE=ai-receptionist-coordination
COORDINATION_REGION=us-east-1
ALLOWED_ORIGINS=
REQUEST_BODY_LIMIT=32kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
IDEMPOTENCY_TTL_MS=900000
RETELL_CALLER_PHONE_HEADER=x-retell-caller-phone
RETELL_CALL_ID_HEADER=x-retell-call-id
